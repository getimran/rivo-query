# Synthetic local-development configuration only. Copy this file to `.env`;
# never replace these values with real or shared-environment credentials here.

# Local control-plane PostgreSQL container
RIVOQUERY_CONTROL_DB_NAME=rivoquery_control
RIVOQUERY_CONTROL_DB_PORT=5432

# Migration/schema-owner credentials. This is the Postgres container's own
# bootstrap superuser (see deploy/local/compose.yaml POSTGRES_USER/PASSWORD);
# Flyway connects with these to run DDL and to grant privileges to the
# restricted runtime role below. The running application never
# authenticates with these credentials. Both variables must be set to a
# value distinct from SPRING_DATASOURCE_USERNAME below - the application
# refuses to start otherwise (see
# com.knowimran.rivoquery.platform.MigrationOwnerSeparationValidator).
SPRING_FLYWAY_USER=rivoquery_migrator
SPRING_FLYWAY_PASSWORD=synthetic-local-only-migrator-change-before-use

# Runtime application role: restricted DML-only privileges, granted by
# migration V2 (apps/api/src/main/resources/db/migration) to a role that
# must already exist. deploy/local/compose.yaml maps these same values to
# RIVOQUERY_RUNTIME_DB_USER/PASSWORD, which
# deploy/local/postgres-initdb/01-create-runtime-role.sh uses to create the
# role out-of-band the first time the local Postgres volume initializes
# (see docs/OPERATIONS.md for the staging/production equivalent). This role
# is deliberately not a table owner, so it cannot ALTER TABLE / DISABLE
# TRIGGER its way around the append-only
# connection_lifecycle_audit_events guarantee.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rivoquery_control
SPRING_DATASOURCE_USERNAME=rivoquery_app
SPRING_DATASOURCE_PASSWORD=synthetic-local-only-app-change-before-use
