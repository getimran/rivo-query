# Synthetic local-development configuration only. Copy this file to `.env`;
# never replace these values with real or shared-environment credentials here.

# Local control-plane PostgreSQL container
RIVOQUERY_CONTROL_DB_NAME=rivoquery_control
RIVOQUERY_CONTROL_DB_PORT=5432

# Shared by the local PostgreSQL container and the host-run Spring API.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rivoquery_control
SPRING_DATASOURCE_USERNAME=rivoquery_local
SPRING_DATASOURCE_PASSWORD=synthetic-local-only-change-before-use
