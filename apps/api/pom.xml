<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.knowimran.rivoquery</groupId>
        <artifactId>rivoquery-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>rivoquery-api</artifactId>
    <name>RivoQuery API</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Compile scope, unlike org.postgresql:postgresql's runtime scope: unlike pgjdbc's
                 javax.net.SocketFactory extension point, Connector/J's own socket-pinning hook
                 (com.mysql.cj.protocol.SocketFactory) is a driver-owned type, so
                 RivoQueryPinnedSocketFactory must reference com.mysql.cj.* classes directly - see
                 platform/connector/mysql/RivoQueryPinnedSocketFactory's class Javadoc.

                 S8 (P2-120 review, flagged not resolved): licensed GPL-2.0-with-Universal-FOSS-Exception,
                 unlike org.postgresql:postgresql's BSD-2 license below. This is a material
                 dependency/distribution decision with no ADR recorded - escalate to product/legal
                 before this connector ships; not an engineering-level decision to resolve here. -->
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <!-- Raw DNS message construction/parsing (TTL, CNAME chain, truncation, rcode) for
                 bounded destination resolution; java.net.InetAddress exposes none of this. -->
            <groupId>dnsjava</groupId>
            <artifactId>dnsjava</artifactId>
            <version>${dnsjava.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- S9 (P2-120 review): org.testcontainers:mysql intentionally omitted - MysqlPhysicalJdbcConnectorIT
             builds its own custom-Dockerfile GenericContainer (TLS cert mounting, custom mysqld TLS
             command flags) and never uses MySQLContainer's built-in JDBC URL/driver wiring, which
             this connector bypasses entirely anyway; keeping the dependency around unused would only
             add an unnecessary artifact to the test classpath. -->

        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.9</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <configuration>
                    <inputSpec>${project.basedir}/src/main/resources/openapi/rivoquery-v1.yaml</inputSpec>
                </configuration>
                <executions>
                    <execution>
                        <id>validate-openapi-contract</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>generate-spring-contract</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>com.knowimran.rivoquery.interfaceapi.generated.api</apiPackage>
                            <modelPackage>com.knowimran.rivoquery.interfaceapi.generated.model</modelPackage>
                            <invokerPackage>com.knowimran.rivoquery.interfaceapi.generated</invokerPackage>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateApiTests>false</generateApiTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateModelTests>false</generateModelTests>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <skipValidateSpec>false</skipValidateSpec>
                            <configOptions>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>none</documentationProvider>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <interfaceOnly>true</interfaceOnly>
                                <openApiNullable>false</openApiNullable>
                                <performBeanValidation>true</performBeanValidation>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useBeanValidation>true</useBeanValidation>
                                <useJakartaEe>true</useJakartaEe>
                                <useResponseEntity>true</useResponseEntity>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                    HealthEndpointIT (the only *IT that boots a full
                    ApplicationContext) transitively pulls in every
                    @Configuration on the classpath via default component
                    scanning, including ConnectionLifecycleWiringConfiguration
                    (P2-130) and JwtAuthenticationConfiguration (P2-130) - both
                    fail application startup outright (by design, matching
                    this codebase's fail-closed-at-startup convention) unless
                    their required configuration is present, even though
                    HealthEndpointIT itself never exercises connection
                    lifecycle, secret-store, or JWT behavior. These values are
                    synthetic, test-only, and never used to protect anything
                    real: RIVOQUERY_SECRETS_LOCAL_* satisfy
                    KeyEncryptionKeyRing/SecretReferenceKey.fromEnvironment
                    (raw System.getenv() reads that Spring test utilities like
                    @DynamicPropertySource cannot override, hence configuring
                    them here rather than in the test class itself), and
                    RIVOQUERY_AUTH_JWT_* satisfy JwtAuthenticationProperties
                    (Spring @ConfigurationProperties, which does support
                    relaxed binding from an environment variable).
                    RIVOQUERY_SECRETS_PROVIDER=local is the post-review S6
                    safety-rail opt-in (see ConnectionLifecycleWiringConfiguration's
                    own Javadoc) - without it, secretStore() now fails closed
                    at startup even in this synthetic test-only configuration.
                    -->
                    <environmentVariables>
                        <RIVOQUERY_SECRETS_PROVIDER>local</RIVOQUERY_SECRETS_PROVIDER>
                        <RIVOQUERY_SECRETS_LOCAL_STORAGE_DIR>${project.build.directory}/it-secrets-storage</RIVOQUERY_SECRETS_LOCAL_STORAGE_DIR>
                        <RIVOQUERY_SECRETS_LOCAL_KEYS>it-test-key-1:sBShCasJ0WoUpRKGPMkg83rVRQ3RW0lXSq/ouA7U/ao=</RIVOQUERY_SECRETS_LOCAL_KEYS>
                        <RIVOQUERY_SECRETS_LOCAL_CURRENT_KEY_ID>it-test-key-1</RIVOQUERY_SECRETS_LOCAL_CURRENT_KEY_ID>
                        <RIVOQUERY_SECRETS_LOCAL_REFERENCE_KEY>2gImhAFjkYAnnA/+phrqrUXOUfpY6evHhlrVQXvcJwk=</RIVOQUERY_SECRETS_LOCAL_REFERENCE_KEY>
                        <RIVOQUERY_AUTH_JWT_ISSUER>https://it-test.invalid/issuer</RIVOQUERY_AUTH_JWT_ISSUER>
                        <RIVOQUERY_AUTH_JWT_AUDIENCE>rivoquery-it-test</RIVOQUERY_AUTH_JWT_AUDIENCE>
                        <RIVOQUERY_AUTH_JWT_HMAC_SECRET_BASE64>8UiYe9QgQVrG93BIC4EmxASGt+O1k3PUcs0A2TLCoZg=</RIVOQUERY_AUTH_JWT_HMAC_SECRET_BASE64>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
